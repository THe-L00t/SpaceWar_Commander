# cube_test.obj — 자체 OBJ 파서 점검용 (2026-10-06, 파서 2단계)
#
#  일부러 이렇게 만들었다:
#    · 면을 «사각형» 으로 적었다          → 부채꼴 삼각화 경로를 지난다
#    · 재질을 둘로 나눴다(옆면/위아래)    → usemtl 로 서브메시가 갈리는지 본다
#    · vt 와 vn 을 모두 넣었다            → UV V 뒤집기·와인딩 보정 경로를 지난다
#    · 텍스처 이미지는 없다               → 무텍스처 재질도 그려지는지 본다
#
#  1m 큐브다. 화면에서는 Model::Initialize 가 2m(kModelHeight)로 맞춰 세운다.
mtllib cube_test.mtl
o CubeTest

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

usemtl CubeBody
f 1/1/1 4/4/1 3/3/1 2/2/1
f 5/1/2 6/2/2 7/3/2 8/4/2
f 1/1/3 5/2/3 8/3/3 4/4/3
f 2/2/4 3/3/4 7/4/4 6/1/4

usemtl CubeCap
f 1/1/5 2/2/5 6/3/5 5/4/5
f 4/4/6 8/3/6 7/2/6 3/1/6
