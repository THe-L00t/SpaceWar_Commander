<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 보통 Microsoft.Cpp.targets가 이미 읽는다. 확장 지점이 없는 환경에서만 직접 읽는다. -->
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" Condition="'$(_ZVcpkgRoot)' == '' and Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets')" />

  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <Target Name="CheckAssimpDependencies" BeforeTargets="PrepareForBuild;VcpkgInstallManifestDependencies" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Text="Assimp 의존성 작업 폴더: $(AssimpDependencyRoot)" Importance="High" />
    <Error Condition="'$(Platform)' != 'x64'" Text="Assimp 모델 로딩은 x64 구성으로 빌드하세요." />
    <Error Condition="'$(VcpkgRoot)' == '' or !Exists('$(VcpkgRoot)\vcpkg.exe') or !Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props') or !Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" Text="Assimp 의존성을 설치할 vcpkg를 찾지 못했습니다. Visual Studio Installer에서 vcpkg 구성 요소를 설치하거나 VCPKG_ROOT를 준비된 vcpkg 폴더로 설정하세요. Client/ASSIMP_SETUP.md를 참고하세요." />
    <Error Condition="'$(VcpkgEnabled)' != 'true' or '$(VcpkgEnableManifest)' != 'true' or '$(VcpkgAutoLink)' != 'true'" Text="Client는 vcpkg 매니페스트 및 자동 연결이 필요합니다. vcpkg 사용, 매니페스트 사용, 자동 연결 설정을 활성화하세요." />
  </Target>
</Project>
