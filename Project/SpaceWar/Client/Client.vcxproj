  <Target Name="CopyModelAssets" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ModelAsset Include="$(ProjectDir)..\..\assets\model\character\*.obj;$(ProjectDir)..\..\assets\model\character\*.mtl;$(ProjectDir)..\..\assets\model\character\*.png" >
