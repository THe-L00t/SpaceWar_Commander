<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- FbxSdk.local.props로 복사한 뒤 실제 include/fbxsdk.h의 상위 SDK 경로를 지정한다. -->
