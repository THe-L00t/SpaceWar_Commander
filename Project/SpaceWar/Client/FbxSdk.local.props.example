    <!-- SDK의 lib 폴더에 있는 compiler 이름을 자동 선택한다. 필요할 때만 직접 지정한다. -->
    <!-- <FbxSdkCompiler>vs2022</FbxSdkCompiler> -->
  </PropertyGroup>
</Project>
