<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    솔루션 탐색기 표시 구조 (가상 폴더). 실제 파일 위치는 바뀌지 않는다.

      Engine/   재사용 코어. 게임 규칙을 모른다.
        Graphics/   ★ DirectX 는 여기 안에만
        Resource/   파일 -> 메모리
        Scene/      렌더러에 넘길 목록 (DX 모름)
        Core/       시간·입력
      Game/     게임플레이. 핸들과 Scene 만 만지고 DX 를 모른다.
      Shared/   Shared 프로젝트 원본을 참조만 한 것 (편집하면 서버에도 반영)
      Temp/     테스트용. 나중에 삭제할 것.

    담당이 갈리므로(이태형=Engine/Graphics, 안병규=Game) 폴더로 나눠
    같은 파일을 동시에 고치는 일을 줄인다.
  -->
  <ItemGroup>
    <Filter Include="Engine">
      <UniqueIdentifier>{5ef825ed-cc00-4fa7-b03f-632cddca209a}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Graphics">
      <UniqueIdentifier>{de98d49f-0aa2-4068-b2b3-811abfea500f}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Graphics\RayTracing">
      <UniqueIdentifier>{90f55430-b43f-4d75-a2f2-2d258ffcbc8c}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Net">
      <UniqueIdentifier>{6c8b2f19-05a4-4d3e-91f7-4a2e8db06c53}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Resource">
      <UniqueIdentifier>{6d2065af-97cf-4f37-85df-bd15b27b8111}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Scene">
      <UniqueIdentifier>{323d9dc2-81da-46ac-b90a-a2e5082572bd}</UniqueIdentifier>
    </Filter>
    <Filter Include="Engine\Core">
      <UniqueIdentifier>{72dc6d85-6601-4ad5-ba7d-fd70f1eb0c5e}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game">
      <UniqueIdentifier>{453914e5-5c21-47b1-8aec-0bd84c5d3f03}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\Player">
      <UniqueIdentifier>{a1ee1f67-7a4a-4430-b1fc-faa544e951d7}</UniqueIdentifier>
    </Filter>
    <Filter Include="Game\World">
      <UniqueIdentifier>{30b81dfc-695e-4b3e-8d88-3cbb99194890}</UniqueIdentifier>
    </Filter>
    <Filter Include="Shared">
      <UniqueIdentifier>{410ca42d-35a6-4354-9c91-e2ff33b2b10a}</UniqueIdentifier>
    </Filter>
    <Filter Include="Shaders">
      <UniqueIdentifier>{2f96d37f-5305-4b29-b44e-f56fc020216f}</UniqueIdentifier>
    </Filter>
    <Filter Include="Temp">
      <UniqueIdentifier>{608964c6-c3d1-4368-825a-a217c14884f5}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <!-- main.cpp 은 진입점이라 필터 없이 최상단에 둔다 -->
    <ClCompile Include="main.cpp" />
    <ClCompile Include="GRenderer.cpp">
      <Filter>Engine\Graphics</Filter>
    </ClCompile>
    <ClCompile Include="ShaderCompiler.cpp">
      <Filter>Engine\Graphics\RayTracing</Filter>
    </ClCompile>
    <ClCompile Include="AccelStructure.cpp">
      <Filter>Engine\Graphics\RayTracing</Filter>
