<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Client 와 같은 규칙을 쓴다.

      소스코드      .cpp
      헤더파일      클래스가 아닌 것 — 패킷 구조체 / 단위 상수 / 데이터 형식
      클래스 목록   클래스가 생기면 여기에 이름별 폴더를 만든다 (아직 없음)

    Shared 는 클라와 서버가 똑같이 알아야 하는 것만 둔다.
    지금은 전부 데이터 정의라 클래스가 하나도 없다.
  -->
  <ItemGroup>
    <Filter Include="소스코드">
      <UniqueIdentifier>{b1f0c724-9a83-4d16-95e7-08c3d2a4f651}</UniqueIdentifier>
    </Filter>
    <Filter Include="헤더파일">
      <UniqueIdentifier>{c31b9a54-7e08-4c62-9a1d-5b0f7e2c4a83}</UniqueIdentifier>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Protocol.h">
      <Filter>헤더파일</Filter>
    </ClInclude>
    <ClInclude Include="Units.h">
      <Filter>헤더파일</Filter>
    </ClInclude>
    <ClInclude Include="HeightmapData.h">
      <Filter>헤더파일</Filter>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Shared.cpp">
      <Filter>소스코드</Filter>
    </ClCompile>
  </ItemGroup>
</Project>
