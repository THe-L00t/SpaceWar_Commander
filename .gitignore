# ==========================================================
#  SpaceWar Commander — .gitignore
#
#  원칙: 빌드가 만들어내는 "폴더"를 통째로 무시한다.
#        에셋 포맷(.obj .fbx .png .dds .wav .bank 등)은 무시하지 않는다.
#        → 빌드 폴더만 제외하므로 assets 안의 모델 .obj 는 그대로 남는다.
# ==========================================================

# ── Visual Studio 작업 / 캐시 폴더 ──
.vs/
ipch/

# ── 빌드 출력 · 중간 파일 폴더 (.obj .pdb .ilk .exe 등이 여기 쌓임) ──
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]64/
[Bb]in/
[Oo]bj/
[Bb]uild/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# ── VS 개인 설정 파일 (에셋 확장자와 안 겹치는 것만 확장자로 제외) ──
*.user
*.suo
*.VC.db
*.VC.VC.opendb
*.aps
*.ncb

# ── 패키지 캐시 (사용 시) ──
packages/
vcpkg_installed/

# ── OS 잡파일 ──
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── AI 도구 작업 로그 (claude-gate 훅이 턴마다 쌓는다. 저장소에 올릴 물건 아님) ──
.claude-gate/

# ── 로컬 외부 의존성 폴더 ──
Project/SpaceWar/external/
